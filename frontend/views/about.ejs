<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>About - Bireena Salesi</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-purple: #7c3aed;
            --primary-purple-dark: #6d28d9;
            --secondary-pink: #ec4899;
            --accent-cyan: #06b6d4;
            --accent-cyan-light: #22d3ee;
            --dark-bg: #0f0318;
            --dark-bg-alt: #1a0b2e;
            --text-primary: #ffffff;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --font-heading: 'Playfair Display', serif;
            --font-body: 'Poppins', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            overflow-x: hidden;
            width: 100%;
        }

        body {
            font-family: var(--font-body);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
            width: 100%;
            max-width: 100vw;
            background: 
                radial-gradient(circle at 20% 50%, rgba(124, 58, 237, 0.3) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(236, 72, 153, 0.3) 0%, transparent 50%),
                linear-gradient(135deg, #0f0318 0%, #1a0b2e 50%, #2d1b4e 100%);
            background-attachment: fixed;
        }

        /* Global Image and Container Overflow Fix */
        img, svg, video {
            max-width: 100%;
            height: auto;
        }

        section, div {
            max-width: 100%;
        }

        /* Navigation */
        .top-navigation {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1.5rem 3rem;
            z-index: 100;
            background: rgba(15, 3, 24, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(124, 58, 237, 0.2);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
        }

        .logo span {
            color: var(--accent-cyan);
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
            position: relative;
        }

        .nav-links a.active {
            color: var(--accent-cyan);
        }

        .nav-links a.active::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--accent-cyan);
        }

        .nav-links a:hover {
            color: var(--accent-cyan);
        }

        .login-btn {
            padding: 0.75rem 2rem;
            background: linear-gradient(135deg, var(--accent-cyan), var(--primary-purple));
            border: none;
            border-radius: 50px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(6, 182, 212, 0.4);
        }

        /* Hero Section */
        .hero-section {
            margin-top: 100px;
            padding: 4rem 3rem;
            max-width: 1400px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid rgba(6, 182, 212, 0.3);
            padding: 0.5rem 1.5rem;
            border-radius: 50px;
            color: var(--accent-cyan);
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 2rem;
        }

        .hero-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
            margin-bottom: 5rem;
        }

        .hero-text h1 {
            font-family: var(--font-heading);
            font-size: 3.5rem;
            line-height: 1.2;
            margin-bottom: 1.5rem;
        }

        .hero-text h1 .highlight {
            background: linear-gradient(135deg, var(--accent-cyan), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-text p {
            font-size: 1.1rem;
            color: var(--text-secondary);
            margin-bottom: 2rem;
            line-height: 1.8;
        }

        .trust-badge {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-top: 3rem;
        }

        .trust-icons {
            display: flex;
            gap: -15px;
        }

        .trust-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-purple), var(--secondary-pink));
            border: 3px solid var(--dark-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
        }

        .trust-text {
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .trust-text strong {
            color: var(--accent-cyan);
            font-weight: 600;
        }

        .hero-image {
            position: relative;
            height: 500px;
            background: rgba(124, 58, 237, 0.1);
            border-radius: 20px;
            border: 1px solid rgba(124, 58, 237, 0.2);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stats-badge {
            position: absolute;
            bottom: 30px;
            right: 30px;
            background: rgba(15, 3, 24, 0.9);
            backdrop-filter: blur(10px);
            padding: 1.5rem 2rem;
            border-radius: 15px;
            border: 1px solid rgba(6, 182, 212, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .stats-badge h3 {
            color: var(--accent-cyan);
            font-size: 2rem;
            margin-bottom: 0.3rem;
        }

        .stats-badge p {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        /* Journey Section */
        .journey-section {
            padding: 5rem 3rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            font-family: var(--font-heading);
            font-size: 3rem;
            margin-bottom: 1.5rem;
        }

        .section-title .highlight {
            background: linear-gradient(135deg, var(--accent-cyan), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .journey-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .journey-text {
            color: var(--text-secondary);
            font-size: 1.05rem;
            line-height: 1.8;
        }

        .journey-text p {
            margin-bottom: 1.5rem;
        }

        .journey-card {
            background: rgba(124, 58, 237, 0.05);
            border: 1px solid rgba(124, 58, 237, 0.2);
            border-radius: 20px;
            padding: 2.5rem;
            backdrop-filter: blur(10px);
        }

        .journey-image {
            height: 400px;
            background: rgba(6, 182, 212, 0.1);
            border-radius: 15px;
            border: 1px solid rgba(6, 182, 212, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
        }

        /* Features Section */
        .features-section {
            padding: 5rem 3rem;
            max-width: 1400px;
            margin: 0 auto;
            text-align: center;
        }

        .features-intro {
            max-width: 800px;
            margin: 0 auto 4rem;
        }

        .features-intro h2 {
            font-family: var(--font-heading);
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .features-intro p {
            color: var(--text-secondary);
            font-size: 1.1rem;
            line-height: 1.8;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .feature-card {
            background: rgba(124, 58, 237, 0.05);
            border: 1px solid rgba(124, 58, 237, 0.2);
            border-radius: 20px;
            padding: 2.5rem;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .feature-card:hover {
            transform: translateY(-10px);
            border-color: var(--accent-cyan);
            box-shadow: 0 20px 40px rgba(6, 182, 212, 0.2);
        }

        .feature-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, var(--primary-purple), var(--secondary-pink));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        .feature-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .feature-card p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.7;
        }

        /* Team Section */
        .team-section {
            padding: 5rem 3rem;
            max-width: 1400px;
            margin: 0 auto;
            text-align: center;
        }

        .team-intro h2 {
            font-family: var(--font-heading);
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .team-intro p {
            color: var(--text-secondary);
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto 4rem;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .team-card {
            background: rgba(124, 58, 237, 0.05);
            border: 1px solid rgba(124, 58, 237, 0.2);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .team-card:hover {
            transform: translateY(-10px);
            border-color: var(--accent-cyan);
            box-shadow: 0 20px 40px rgba(6, 182, 212, 0.2);
        }

        .team-image {
            height: 300px;
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.3), rgba(236, 72, 153, 0.3));
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .team-info {
            padding: 2rem;
            text-align: center;
        }

        .team-info h3 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
        }

        .team-info .role {
            color: var(--accent-cyan);
            font-size: 0.95rem;
            margin-bottom: 1rem;
            font-weight: 500;
        }

        .team-info p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .team-social {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 1rem;
        }

        .social-icon {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid rgba(6, 182, 212, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-cyan);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-icon:hover {
            background: var(--accent-cyan);
            color: white;
            transform: translateY(-3px);
        }

        /* Footer */
        .footer {
            background: linear-gradient(135deg, #0a0515 0%, #0d0820 50%, #1a0b2e 100%);
            border-top: 1px solid rgba(124, 58, 237, 0.3);
            padding: 4rem 3rem 2rem;
            margin-top: 5rem;
        }

        .footer-content {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .footer-card {
            background: rgba(15, 6, 40, 0.6);
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 16px;
            padding: 2rem;
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
        }

        .footer-card:hover {
            background: rgba(20, 10, 50, 0.8);
            border-color: rgba(6, 182, 212, 0.6);
            box-shadow: 0 8px 32px rgba(6, 182, 212, 0.2),
                        0 0 40px rgba(124, 58, 237, 0.15);
            transform: translateY(-5px);
        }

        .footer-brand h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }

        .footer-brand .highlight {
            color: var(--accent-cyan);
        }

        .footer-contact {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .contact-item {
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .contact-icon {
            color: var(--accent-cyan);
            margin-top: 3px;
        }

        .footer-section h4 {
            color: #ffffff;
            margin-bottom: 1.5rem;
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .footer-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.3s ease;
            position: relative;
            padding-left: 1.25rem;
        }

        .footer-links a::before {
            content: '→';
            color: var(--accent-cyan);
            position: absolute;
            left: 0;
            opacity: 0;
            transform: translateX(-5px);
            transition: all 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--accent-cyan);
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
            padding-left: 1.5rem;
        }

        .footer-links a:hover::before {
            opacity: 1;
            transform: translateX(0);
        }

        .footer-hours {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.8;
        }

        .footer-hours .time {
            color: var(--accent-cyan);
            font-weight: 600;
            font-size: 1rem;
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
        }

        .social-links {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .social-link {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid rgba(6, 182, 212, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-cyan);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-link:hover {
            background: var(--accent-cyan);
            color: white;
            transform: translateY(-3px);
        }

        .footer-bottom {
            text-align: center;
            padding-top: 2rem;
            border-top: 1px solid rgba(124, 58, 237, 0.2);
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .footer-bottom a {
            color: var(--accent-cyan);
            text-decoration: none;
        }

        /* Responsive */
        @media (max-width: 968px) {
            .hero-content,
            .journey-content {
                grid-template-columns: 1fr;
            }

            .features-grid,
            .team-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-content {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 640px) {
            .features-grid,
            .team-grid,
            .footer-content {
                grid-template-columns: 1fr;
            }

            .nav-links {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="top-navigation">
        <div class="nav-container">
            <a href="/" class="logo">BIREENA<span>SALESI</span></a>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about" class="active">About</a></li>
                <li><a href="/features">Features</a></li>
                <li><a href="/pricing">Pricing</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
            <a href="/login" class="login-btn">Login →</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <span class="hero-badge">About Bireena Salesi</span>
        
        <div class="hero-content">
            <div class="hero-text">
                <h1>
                    Elevating Sales Management<br>
                    <span class="highlight">to New Heights</span>
                </h1>
                <p>
                    We're not just a software company – we're your partner in transforming business operations. 
                    Our mission is to make sales and inventory management more efficient, more intuitive, and more profitable.
                </p>

                <div class="trust-badge">
                    <div class="trust-icons">
                        <div class="trust-icon">🏨</div>
                        <div class="trust-icon">✓</div>
                        <div class="trust-icon">⭐</div>
                        <div class="trust-icon">💎</div>
                    </div>
                    <div class="trust-text">
                        Trusted by <strong>500+</strong> businesses across India
                    </div>
                </div>
            </div>

            <div class="hero-image">
                <div style="color: var(--text-muted); font-size: 1rem;">Sales Management Illustration</div>
                <div class="stats-badge">
                    <h3>98% Success Rate</h3>
                    <p>In Implementation</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Journey Section -->
    <section class="journey-section">
        <h2 class="section-title">Our <span class="highlight">Journey</span></h2>
        
        <div class="journey-content">
            <div class="journey-text">
                <p>
                    Launched in 2025, Bireena Salesi was born from the need to simplify complex sales operations. 
                    Our name combines "Bireena" (excellence) and "Salesi" (sales/commerce), reflecting our mission to 
                    elevate business management through technology.
                </p>
            </div>

            <div class="journey-image">
                <div>Journey Visualization</div>
            </div>
        </div>

        <div class="journey-card" style="margin-top: 3rem;">
            <p>
                What began as a simple billing system has evolved into a comprehensive sales management platform. 
                We've continuously added features and capabilities based on real feedback from business owners and 
                retail professionals, ensuring our solution addresses actual industry needs.
            </p>
            <p style="margin-top: 1.5rem;">
                Today, Bireena Salesi powers hundreds of businesses across India and beyond, streamlining everything 
                from sales and billing to inventory management and financial reporting. Our platform 
                brings modern efficiency while preserving the personal touch that makes business special.
            </p>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <div class="features-intro">
            <h2>Key <span class="highlight">Features</span></h2>
            <p>
                Our platform is built with powerful features that help you manage your business more efficiently, 
                improve customer satisfaction, and increase revenue.
            </p>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">💰</div>
                <h3>Fast Billing System</h3>
                <p>Generate bills instantly with automated calculations, discount management, and print-ready invoices for seamless checkout experience.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">📦</div>
                <h3>Inventory Management</h3>
                <p>Track stock levels in real-time, get low-stock alerts, manage products efficiently, and never run out of your bestsellers.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3>Sales Analytics</h3>
                <p>Monitor daily sales, track revenue trends, analyze employee performance, and make data-driven business decisions.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">👥</div>
                <h3>Employee Management</h3>
                <p>Role-based access control, activity tracking, performance monitoring, and secure authentication for your team members.</p>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="team-section">
        <div class="team-intro">
            <h2>Meet Our <span class="highlight">Team</span></h2>
            <p>
                The passionate individuals behind Bireena Salesi who are dedicated to revolutionizing sales management.
            </p>
        </div>

        <div class="team-grid">
            <div class="team-card">
                <div class="team-image">
                    Birendra Kumar
                </div>
                <div class="team-info">
                    <h3>Birendra Kumar</h3>
                    <p class="role">Founder & CEO</p>
                    <p>Visionary leader with 10+ years of experience in retail and business technology.</p>
                    <div class="team-social">
                        <a href="#" class="social-icon">📘</a>
                        <a href="#" class="social-icon">🐦</a>
                    </div>
                </div>
            </div>

            <div class="team-card">
                <div class="team-image">
                    Team Member 2
                </div>
                <div class="team-info">
                    <h3>Team Member 2</h3>
                    <p class="role">Head of Technology</p>
                    <p>Expert in cloud architecture and scalable software solutions.</p>
                    <div class="team-social">
                        <a href="#" class="social-icon">📘</a>
                        <a href="#" class="social-icon">💻</a>
                    </div>
                </div>
            </div>

            <div class="team-card">
                <div class="team-image">
                    Team Member 3
                </div>
                <div class="team-info">
                    <h3>Team Member 3</h3>
                    <p class="role">Product Manager</p>
                    <p>Specialized in creating user-centric solutions for the retail and sales industry.</p>
                    <div class="team-social">
                        <a href="#" class="social-icon">📘</a>
                        <a href="#" class="social-icon">🔗</a>
                    </div>
                </div>
            </div>

            <div class="team-card">
                <div class="team-image">
                    Team Member 4
                </div>
                <div class="team-info">
                    <h3>Team Member 4</h3>
                    <p class="role">Customer Success Lead</p>
                    <p>Dedicated to ensuring smooth implementation and client satisfaction.</p>
                    <div class="team-social">
                        <a href="#" class="social-icon">📘</a>
                        <a href="#" class="social-icon">🔗</a>
                    </div>
                </div>
            </div>
        </div>
