<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - Bireena Bakery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h4><i class="bi bi-plus-circle"></i> Add New Product</h4>
                    </div>
                    <div class="card-body">
                        <form action="/inventory/add" method="POST">
                            <!-- Basic Information -->
                            <h5 class="mb-3 text-primary"><i class="bi bi-info-circle"></i> Basic Information</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Product Name *</label>
                                    <input type="text" class="form-control" name="name" placeholder="e.g., Chocolate Cake" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Category *</label>
                                    <input type="text" class="form-control" name="category" list="categoryList" placeholder="e.g., Bread, Cake, Pastry" required>
                                    <datalist id="categoryList">
                                        <option value="Bread">
                                        <option value="Cake">
                                        <option value="Pastry">
                                        <option value="Cookie">
                                        <option value="Snacks">
                                        <option value="Beverages">
                                        <option value="Other">
                                    </datalist>
                                    <small class="text-muted">Type or select from suggestions</small>
                                </div>
                            </div>

                            <!-- Pricing Information -->
                            <h5 class="mb-3 text-primary mt-4"><i class="bi bi-cash-coin"></i> Pricing & Profit</h5>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Purchase Price (₹) *</label>
                                    <input type="number" class="form-control" name="purchasePrice" id="purchasePrice" step="0.01" min="0" placeholder="0.00" required>
                                    <small class="text-muted">Cost price per unit</small>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Selling Price (₹) *</label>
                                    <input type="number" class="form-control" name="sellingPrice" id="sellingPrice" step="0.01" min="0" placeholder="0.00" required>
                                    <small class="text-muted">MRP/Selling price</small>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Profit Per Item (₹)</label>
                                    <input type="number" class="form-control" id="profitPerItem" readonly>
                                    <small class="text-muted" id="profitPercentage">0% margin</small>
                                </div>
                            </div>

                            <!-- Stock Information -->
                            <h5 class="mb-3 text-primary mt-4"><i class="bi bi-box-seam"></i> Stock Details</h5>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Stock Quantity *</label>
                                    <input type="number" class="form-control" name="stock" min="0" placeholder="0" required>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Unit *</label>
                                    <select class="form-select" name="unit" required>
                                        <option value="piece">Piece</option>
                                        <option value="kg">Kilogram (kg)</option>
                                        <option value="dozen">Dozen</option>
                                        <option value="box">Box</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Reorder Level *</label>
                                    <input type="number" class="form-control" name="reorderLevel" min="0" value="10" required>
                                    <small class="text-muted">Low stock alert level</small>
                                </div>
                            </div>

                            <!-- Expiry Information -->
                            <h5 class="mb-3 text-primary mt-4"><i class="bi bi-calendar-event"></i> Dates & Expiry</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Manufacturing Date</label>
                                    <input type="date" class="form-control" name="mfgDate">
                                    <small class="text-muted">Optional for tracking</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Expiry Date</label>
                                    <input type="date" class="form-control" name="expiryDate">
                                    <small class="text-muted">Leave blank if no expiry</small>
                                </div>
                            </div>

                            <!-- Supplier Information -->
                            <h5 class="mb-3 text-primary mt-4"><i class="bi bi-truck"></i> Supplier/Vendor Details</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Supplier Name</label>
                                    <input type="text" class="form-control" name="supplierName" placeholder="e.g., ABC Suppliers">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Supplier Contact</label>
                                    <input type="text" class="form-control" name="supplierContact" placeholder="e.g., +91 9876543210">
                                </div>
                            </div>

                            <!-- Batch & Branch -->
                            <h5 class="mb-3 text-primary mt-4"><i class="bi bi-tag"></i> Additional Details</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Batch Number</label>
                                    <input type="text" class="form-control" name="batchNumber" placeholder="e.g., BATCH-2025-001">
                                    <small class="text-muted">Optional batch tracking</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Branch</label>
                                    <input type="text" class="form-control" name="branch" value="Main Branch">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="description" rows="2" placeholder="Additional notes about the product..."></textarea>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a href="/inventory" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="bi bi-check-circle"></i> Add Product
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<!-- End Main Content Wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 🎯 Auto-calculate profit and margin
        function calculateProfit() {
            const purchasePrice = parseFloat(document.getElementById('purchasePrice').value) || 0;
            const sellingPrice = parseFloat(document.getElementById('sellingPrice').value) || 0;
            const profitPerItem = sellingPrice - purchasePrice;
            const profitMargin = purchasePrice > 0 ? ((profitPerItem / purchasePrice) * 100).toFixed(2) : 0;
            
            document.getElementById('profitPerItem').value = profitPerItem.toFixed(2);
            document.getElementById('profitPercentage').textContent = `${profitMargin}% margin`;
            
            // Color coding
            if (profitPerItem < 0) {
                document.getElementById('profitPerItem').style.color = 'red';
                document.getElementById('profitPercentage').style.color = 'red';
            } else if (profitPerItem > 0) {
                document.getElementById('profitPerItem').style.color = 'green';
                document.getElementById('profitPercentage').style.color = 'green';
            } else {
                document.getElementById('profitPerItem').style.color = 'black';
                document.getElementById('profitPercentage').style.color = 'gray';
            }
        }
        
        document.getElementById('purchasePrice').addEventListener('input', calculateProfit);
        document.getElementById('sellingPrice').addEventListener('input', calculateProfit);
    </script>
</body>
</html>
