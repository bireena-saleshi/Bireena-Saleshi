<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales History - Bireena Bakery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container-fluid mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-receipt"></i> Sales History</h2>
            <a href="/sales/new" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> New Sale
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <% if (sales.length === 0) { %>
                    <p class="text-center text-muted">No sales recorded yet</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Bill #</th>
                                    <th>Date & Time</th>
                                    <th>Customer</th>
                                    <th>Items</th>
                                    <th>Total</th>
                                    <th>Paid</th>
                                    <th>Due</th>
                                    <th>Payment Status</th>
                                    <th>SMS</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% sales.forEach(sale => { %>
                                    <tr>
                                        <td><strong><%= sale.billNumber %></strong></td>
                                        <td><%= new Date(sale.createdAt).toLocaleString() %></td>
                                        <td>
                                            <%= sale.customerName %><br>
                                            <% if (sale.customerPhone) { %>
                                                <small class="text-muted"><%= sale.customerPhone %></small>
                                            <% } %>
                                        </td>
                                        <td><%= sale.items.length %></td>
                                        <td><strong>₹<%= sale.total.toFixed(2) %></strong></td>
                                        <td class="text-success">₹<%= sale.amountPaid.toFixed(2) %></td>
                                        <td class="<%= sale.dueAmount > 0 ? 'text-danger fw-bold' : '' %>">
                                            ₹<%= sale.dueAmount.toFixed(2) %>
                                        </td>
                                        <td>
                                            <span class="payment-status <%= sale.paymentStatus %>">
                                                <% if (sale.paymentStatus === 'paid') { %>
                                                    <i class="bi bi-check-circle"></i> Paid
                                                <% } else if (sale.paymentStatus === 'partial') { %>
                                                    <i class="bi bi-exclamation-circle"></i> Partial
                                                <% } else { %>
                                                    <i class="bi bi-x-circle"></i> Due
                                                <% } %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (sale.smsSent) { %>
                                                <i class="bi bi-check-circle text-success" title="SMS Sent"></i>
                                            <% } else { %>
                                                <i class="bi bi-x-circle text-muted" title="SMS Not Sent"></i>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/bill/<%= sale._id %>" class="btn btn-sm btn-info" title="View Bill">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="/bill/print/<%= sale._id %>" target="_blank" class="btn btn-sm btn-secondary" title="Print">
                                                <i class="bi bi-printer"></i>
                                            </a>
                                            <% if (sale.dueAmount > 0) { %>
                                                <a href="/bill/<%= sale._id %>#clear-due" class="btn btn-sm btn-warning" title="Clear Due">
                                                    <i class="bi bi-cash-stack"></i>
                                                </a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
