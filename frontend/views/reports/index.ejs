<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports & Analytics - Bireena Bakery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show m-3">
            <%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <div class="container-fluid mt-4">
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="bi bi-graph-up"></i> Reports & Analytics</h2>
                <a href="/reports/expense/add" class="btn btn-danger">
                    <i class="bi bi-plus-circle"></i> Add Expense
                </a>
            </div>
        </div>

        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <form action="/reports" method="GET" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Start Date</label>
                        <input type="date" class="form-control" name="startDate" value="<%= filters.startDate || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">End Date</label>
                        <input type="date" class="form-control" name="endDate" value="<%= filters.endDate || '' %>">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Type</label>
                        <select class="form-select" name="type">
                            <option value="">All</option>
                            <option value="sales" <%= filters.type === 'sales' ? 'selected' : '' %>>Sales Only</option>
                            <option value="expenses" <%= filters.type === 'expenses' ? 'selected' : '' %>>Expenses Only</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Payment Status</label>
                        <select class="form-select" name="paymentStatus">
                            <option value="">All Payments</option>
                            <option value="paid" <%= filters.paymentStatus === 'paid' ? 'selected' : '' %>>Paid Only</option>
                            <option value="partial" <%= filters.paymentStatus === 'partial' ? 'selected' : '' %>>Partial</option>
                            <option value="due" <%= filters.paymentStatus === 'due' ? 'selected' : '' %>>Due Only</option>
                        </select>
                    </div>
                    <% if (user.role === 'admin' && employees.length > 0) { %>
                    <div class="col-md-2">
                        <label class="form-label">Employee</label>
                        <select class="form-select" name="employee">
                            <option value="">All Employees</option>
                            <% employees.forEach(emp => { %>
                                <option value="<%= emp._id %>" <%= filters.employee === emp._id.toString() ? 'selected' : '' %>>
                                    <%= emp.fullName || emp.username %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <% } %>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-funnel"></i> Filter
                        </button>
                        <a href="/reports" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Statistics -->
        <div class="row g-4 mb-4">
            <div class="col-md-2-4">
                <div class="card stat-card bg-success text-white">
                    <div class="card-body">
                        <h6>Total Sales</h6>
                        <h3>₹<%= stats.totalSales.toFixed(2) %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="card stat-card bg-info text-white">
                    <div class="card-body">
                        <h6>Amount Paid</h6>
                        <h3>₹<%= stats.totalPaid.toFixed(2) %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="card stat-card bg-warning text-white">
                    <div class="card-body">
                        <h6>Total Due</h6>
                        <h3>₹<%= stats.totalDue.toFixed(2) %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="card stat-card bg-danger text-white">
                    <div class="card-body">
                        <h6>Total Expenses</h6>
                        <h3>₹<%= stats.totalExpenses.toFixed(2) %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="card stat-card <%= stats.profit >= 0 ? 'bg-purple' : 'bg-danger' %> text-white">
                    <div class="card-body">
                        <h6>Net Profit</h6>
                        <h3>₹<%= stats.profit.toFixed(2) %></h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Sales Table -->
            <% if (!filters.type || filters.type !== 'expenses') { %>
            <div class="col-md-<%= filters.type === 'sales' ? '12' : '6' %> mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-cart-check"></i> Sales (<%= sales.length %>)</h5>
                    </div>
                    <div class="card-body">
                        <% if (sales.length === 0) { %>
                            <p class="text-muted text-center">No sales in this period</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Bill #</th>
                                            <th>Date</th>
                                            <th>Customer</th>
                                            <th>Employee</th>
                                            <th>Total</th>
                                            <th>Paid</th>
                                            <th>Due</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% sales.forEach(sale => { %>
                                            <tr>
                                                <td><a href="/bill/<%= sale._id %>"><%= sale.billNumber %></a></td>
                                                <td><%= new Date(sale.createdAt).toLocaleDateString() %></td>
                                                <td><%= sale.customerName %></td>
                                                <td>
                                                    <% if (sale.createdBy) { %>
                                                        <span class="badge bg-primary">
                                                            <i class="bi bi-person-badge"></i>
                                                            <%= sale.createdBy.fullName || sale.createdBy.username %>
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary">
                                                            <i class="bi bi-person-x"></i> Unknown
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td>₹<%= sale.total.toFixed(2) %></td>
                                                <td>₹<%= sale.amountPaid.toFixed(2) %></td>
                                                <td class="<%= sale.dueAmount > 0 ? 'text-danger fw-bold' : '' %>">
                                                    ₹<%= sale.dueAmount.toFixed(2) %>
                                                </td>
                                                <td>
                                                    <span class="payment-status <%= sale.paymentStatus %>">
                                                        <% if (sale.paymentStatus === 'paid') { %>
                                                            <i class="bi bi-check-circle"></i> Paid
                                                        <% } else if (sale.paymentStatus === 'partial') { %>
                                                            <i class="bi bi-exclamation-circle"></i> Partial
                                                        <% } else { %>
                                                            <i class="bi bi-x-circle"></i> Due
                                                        <% } %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Expenses Table -->
            <% if (!filters.type || filters.type !== 'sales') { %>
            <div class="col-md-<%= filters.type === 'expenses' ? '12' : '6' %> mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-cash-coin"></i> Expenses (<%= expenses.length %>)</h5>
                    </div>
                    <div class="card-body">
                        <% if (expenses.length === 0) { %>
                            <p class="text-muted text-center">No expenses in this period</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Category</th>
                                            <th>Description</th>
                                            <th>Employee</th>
                                            <th>Amount</th>
                                            <th>Payment</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% expenses.forEach(expense => { %>
                                            <tr>
                                                <td><%= new Date(expense.date).toLocaleDateString() %></td>
                                                <td><span class="badge bg-secondary"><%= expense.category %></span></td>
                                                <td><%= expense.description %></td>
                                                <td>
                                                    <% if (expense.addedBy) { %>
                                                        <span class="badge bg-info">
                                                            <i class="bi bi-person-badge"></i>
                                                            <%= expense.addedBy.fullName || expense.addedBy.username %>
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary">
                                                            <i class="bi bi-person-x"></i> Unknown
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td class="fw-bold">₹<%= expense.amount.toFixed(2) %></td>
                                                <td><%= expense.paymentMethod.toUpperCase() %></td>
                                                <td>
                                                    <form action="/reports/expense/delete/<%= expense._id %>" method="POST" class="d-inline"
                                                          onsubmit="return confirm('Delete this expense?')">
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
